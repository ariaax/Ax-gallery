<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ax_splash">#040405</color>

    <!-- Same as Theme.IrisGallery, but the system splash is just a black screen (no logo), so the only launch animation is the liquid intro. -->
    <style name="Theme.AxGallery" parent="Theme.IrisGallery">
        <item name="android:windowBackground">@color/ax_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ax_splash_empty</item>
        <item name="android:windowSplashScreenBackground">@color/ax_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
