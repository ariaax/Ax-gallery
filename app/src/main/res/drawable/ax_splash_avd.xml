<?xml version="1.0" encoding="utf-8"?>
<!-- Launch logo, collage style: paper chips with A and X land on cobalt, orbit line draws, star pops. Render-thread animation. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="288dp" android:height="288dp" android:viewportWidth="288" android:viewportHeight="288">
            <group android:name="orbit_rot" android:pivotX="144" android:pivotY="144" android:rotation="-18">
                <path android:name="orbit" android:pathData="M56,144 a88,36 0 1,1 176,0 a88,36 0 1,1 -176,0"
                    android:strokeColor="#FFFFFF" android:strokeWidth="2.4" android:trimPathEnd="0" />
            </group>
            <group android:name="dots_g" android:translateY="12">
                <path android:name="dots" android:fillColor="#FFFFFF" android:fillAlpha="0"
                    android:pathData="M74,200 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M84,200 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M94,200 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M79,208 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M89,208 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 M99,208 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
            </group>
            <group android:name="chipA_move" android:translateX="-170">
                <group android:pivotX="118" android:pivotY="150" android:rotation="-7" android:translateX="-10">
                    <path android:fillColor="#000000" android:fillAlpha="0.28" android:pathData="M87,121 L157,121 L157,191 L87,191 Z" />
                    <path android:fillColor="#FFFFFF" android:pathData="M83,115 L153,115 L153,185 L83,185 Z" />
                    <path android:fillColor="#0C0C10" android:pathData="M88,120 L148,120 L148,180 L88,180 Z" />
                    <path android:strokeColor="#FFFFFF" android:strokeWidth="9" android:strokeLineJoin="miter"
                        android:pathData="M101,174 L118,126 L135,174 M107,160 L129,160" />
                </group>
            </group>
            <group android:name="chipX_move" android:translateY="-190">
                <group android:pivotX="166" android:pivotY="140" android:rotation="6" android:translateX="11">
                    <path android:fillColor="#000000" android:fillAlpha="0.28" android:pathData="M140,111 L200,111 L200,181 L140,181 Z" />
                    <path android:fillColor="#FFFFFF" android:pathData="M136,105 L196,105 L196,175 L136,175 Z" />
                    <path android:strokeColor="#0A1CD6" android:strokeWidth="10" android:pathData="M151,122 L181,158 M181,122 L151,158" />
                    <path android:name="glitch1" android:fillColor="#0A1CD6" android:fillAlpha="0" android:pathData="M128,134 L204,134 L204,139 L128,139 Z" />
                </group>
            </group>
            <group android:name="bar_g" android:pivotX="96" android:pivotY="196" android:scaleX="0">
                <path android:fillColor="#0C0C10" android:pathData="M96,193 L178,193 L178,199 L96,199 Z" />
            </group>
            <group android:name="star_g" android:pivotX="204" android:pivotY="98" android:scaleX="0" android:scaleY="0">
                <path android:fillColor="#0C0C10" android:pathData="M204,78 L209,93 L224,98 L209,103 L204,118 L199,103 L184,98 L199,93 Z" />
                <path android:fillColor="#FFFFFF" android:pathData="M204,82 L208,94 L220,98 L208,102 L204,114 L200,102 L188,98 L200,94 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="orbit">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="620"
                    android:startOffset="0"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="chipA_move">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="420"
                    android:startOffset="60"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateX"
                    android:valueFrom="-170"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="chipX_move">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="460"
                    android:startOffset="200"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateY"
                    android:valueFrom="-190"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="glitch1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="40"
                    android:startOffset="560"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="0.95"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="40"
                    android:startOffset="610"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.95"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="40"
                    android:startOffset="680"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="0.95"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="60"
                    android:startOffset="730"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.95"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bar_g">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="260"
                    android:startOffset="520"
                    android:interpolator="@android:interpolator/decelerate_quad"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="star_g">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="320"
                    android:startOffset="560"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="320"
                    android:startOffset="560"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="380"
                    android:startOffset="560"
                    android:propertyName="rotation"
                    android:valueFrom="-90"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dots">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="200"
                    android:startOffset="640"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
